---
# 风格基线：Google + 项目定制（4 空格缩进 / Allman 大括号 / 120 列行宽）
# 适用版本：clang-format 18；未在此处声明的选项一律继承 BasedOnStyle: Google 的默认值
Language:        Cpp
BasedOnStyle:    Google
Standard:        c++17

# ------------------------------------------------------------------ 缩进
IndentWidth:     4                  # 项目定制（Google 默认 2）
TabWidth:        4                  # 与 IndentWidth 保持一致，避免 Tab/空格混用
UseTab:          Never
ContinuationIndentWidth: 4          # 续行缩进与缩进宽度一致
AccessModifierOffset: -4            # public/private/protected 相对类体左移一个缩进
ConstructorInitializerIndentWidth: 4
NamespaceIndentation: All           # 项目定制（Google 默认 None）

# ------------------------------------------------------- 大括号（Allman）
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass:      true
  AfterControlStatement: Always     # if/for/while 后换行（枚举值，非布尔）
  AfterEnum:       true
  AfterExternBlock: true
  AfterFunction:   true
  AfterNamespace:  true
  AfterStruct:     true
  AfterUnion:      true
  BeforeCatch:     true
  BeforeElse:      true
  IndentBraces:    false

# ------------------------------------------------------------ 行宽与注释
ColumnLimit:     120                # 项目定制（Google 默认 80）
ReflowComments:  false              # 不自动重排注释，保留手写排版

# ------------------------------------------------------------------ 对齐
AlignConsecutiveAssignments:
  Enabled:         true
  PadOperators:    true             # 对齐时一并补齐运算符两侧空格
AlignConsecutiveDeclarations:
  Enabled:         true
  PadOperators:    true
AlignArrayOfStructures: Left        # 项目定制（Google 默认 None）
AlignEscapedNewlines: Right         # 宏续行反斜杠右对齐

# ------------------------------------------------------- 禁止短代码块合并
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false

# -------------------------------------------------------------- 参数换行
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# -------------------------------------------------------- 指针/引用/lambda
DerivePointerAlignment: false       # 强制 PointerAlignment，不按文件内容推导
PointerAlignment: Left              # std::string* ptr / const std::string& ref
LambdaBodyIndentation: OuterScope   # 项目定制（Google 默认 Signature）
BreakBeforeBinaryOperators: All     # 项目定制（Google 默认 None）：换行时运算符前置

# -------------------------------------------------------- 构造初始化列表
# 替代已废弃的 ConstructorInitializerAllOnOneLineOrOnePerLine
PackConstructorInitializers: NextLine

# ---------------------------------------------------------------- include
IncludeBlocks:   Preserve           # 不重排 include 分组（Google 默认 Regroup）
SortIncludes:    CaseSensitive      # 组内排序（显式写法，等价于旧的 true）
