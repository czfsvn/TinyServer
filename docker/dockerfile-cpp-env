# ============================================================================
# C++ 开发环境 Docker 镜像
# 基础: Ubuntu 22.04
# ============================================================================

FROM ubuntu:22.04

# ============================================================================
# 环境变量
# ============================================================================
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8

# 第三方库统一安装前缀
ENV THIRD_PARTY_INSTALL_PREFIX=/usr/local/third

# 第三方库版本
ENV MYSQLPP_VERSION=3.3.0 \
    BOOST_VERSION=1.85.0 \
    BOOST_VERSION_UNDERSCORE=1_85_0 \
    PROTOBUF_VERSION=21.12 \
    PROTOBUF_FULL_VERSION=3.21.12 \
    FMT_VERSION=10.2.1 \
    SPDLOG_VERSION=1.12.0 \
    HIREDIS_VERSION=1.2.0 \
    GTEST_VERSION=1.15.2

# 编译/链接/运行时路径
ENV CMAKE_PREFIX_PATH=${THIRD_PARTY_INSTALL_PREFIX} \
    PKG_CONFIG_PATH=${THIRD_PARTY_INSTALL_PREFIX}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig \
    LD_LIBRARY_PATH=${THIRD_PARTY_INSTALL_PREFIX}/lib \
    PATH=${THIRD_PARTY_INSTALL_PREFIX}/bin:${PATH}

# ============================================================================
# 基础系统包 & 工具链（单层安装，减少镜像体积）
# ============================================================================
RUN apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common wget curl gnupg \
    && add-apt-repository universe \
    && add-apt-repository multiverse \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        # ---- 中文语言支持 ----
        language-pack-zh-hans \
        language-pack-zh-hant \
        fonts-noto-cjk \
        fonts-wqy-microhei \
        fonts-wqy-zenhei \
        # ---- 时区 ----
        tzdata \
        # ---- 编译工具链 ----
        build-essential \
        cmake \
        pkg-config \
        make \
        autoconf \
        automake \
        libtool \
        m4 \
        gcc \
        g++ \
        clang \
        clang-format \
        clang-tidy \
        clangd \
        # ---- 调试 & 性能分析 ----
        gdb \
        gdb-multiarch \
        valgrind \
        strace \
        ltrace \
        binutils \
        linux-tools-common \
        linux-tools-generic \
        # ---- Sanitizer 运行时库 ----
        libasan6 \
        libubsan1 \
        liblsan0 \
        libtsan0 \
        # ---- 版本控制 ----
        git \
        subversion \
        # ---- 网络工具 ----
        curl \
        wget \
        telnet \
        net-tools \
        iputils-ping \
        dnsutils \
        lrzsz \
        # ---- 压缩/解压 ----
        unzip \
        zip \
        tar \
        gzip \
        bzip2 \
        xz-utils \
        # ---- 文本编辑器 ----
        vim \
        vim-gtk3 \
        nano \
        # ---- Vim 插件依赖 ----
        universal-ctags \
        cscope \
        nodejs \
        npm \
        # ---- 代码分析 ----
        cppcheck \
        # ---- Python 环境 ----
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        # ---- 编译依赖 ----
        zlib1g-dev \
        libssl-dev \
        libbz2-dev \
        libicu-dev \
        # ---- MySQL 客户端 ----
        libmysqlclient-dev \
        default-libmysqlclient-dev \
        mysql-client \
        libmysql++-dev \
        libyaml-cpp-dev \
        # ---- Redis ----
        redis-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---- Python 包（独立 RUN，避免混入 apt-get） ----
RUN pip3 install --no-cache-dir grpcio-tools

# ============================================================================
# 时区 & 语言环境
# ============================================================================
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && locale-gen zh_CN.UTF-8 \
    && update-locale LANG=zh_CN.UTF-8 LANGUAGE=zh_CN:zh LC_ALL=zh_CN.UTF-8

# ============================================================================
# Shell 别名（.bashrc）
# ============================================================================
RUN cat >> /root/.bashrc << 'BASHREOF'

# ==================== 常用 alias ====================
alias tailf='tail -f'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# 系统监控
alias ports='netstat -tulanp'
alias meminfo='free -h'
alias diskinfo='df -h'

# 网络
alias ping1='ping -c 1'
alias curlj='curl -s | python3 -m json.tool'

# 文件操作
alias copy='cp -i'
alias move='mv -i'

# 编译运行
alias makec='cmake .. && cmake --build .'
alias run='./app'

# Docker
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'

# 进程
alias pst='ps aux | grep'
alias kill9='kill -9'

# ==================== Git alias ====================
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias gm='git merge'
alias gr='git rebase'
alias gst='git stash'
alias gstp='git stash pop'

# ==================== CMake alias ====================
alias cm='cmake ..'
alias cma='cmake .. -DCMAKE_BUILD_TYPE=Debug'
alias cmr='cmake .. -DCMAKE_BUILD_TYPE=Release'
alias cb='cmake --build .'
alias cn='cmake --build . -- -j$(nproc)'
alias cclean='rm -rf build && mkdir build && cd build'

# ==================== 数据库客户端 ====================
alias cli-mysql='mysql -h mysql-8-0 -P 3306 -u user -p123456'
alias cli-redis='redis-cli -h redis-7-2 -p 6379 -a 123456'

export TZ=Asia/Shanghai

BASHREOF

# ============================================================================
# Vim 配置
# ============================================================================
RUN cat > /root/.vimrc << 'VIMEOF'
" ============================================
" 基础设置
" ============================================
set nocompatible
filetype plugin indent on
syntax on

" 编码
set encoding=utf-8
set fileencodings=utf-8,gbk,gb2312,gb18030,cp936
set termencoding=utf-8

" 显示
set number
set relativenumber
set cursorline
set cursorcolumn
set showmatch
set matchtime=2
set ruler
set showcmd
set laststatus=2

" 缩进
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set autoindent
set smartindent

" 搜索
set hlsearch
set incsearch
set ignorecase
set smartcase

" 折叠
set foldmethod=syntax
set foldlevel=99

" 文件
set nobackup
set nowritebackup
set noswapfile
set autoread

" 剪贴板 & 鼠标
set clipboard=unnamedplus
set mouse=a
set mousehide

" ============================================
" 主题
" ============================================
set background=dark
colorscheme gruvbox

" ============================================
" GDB 集成快捷键
" ============================================
nmap <F9> :!gdb -tui %:r<CR>
nmap <F10> :!gdb -q -ex run %:r<CR>
nmap <F11> :!gdb -q -ex "break main" -ex run %:r<CR>

" ============================================
" 插件管理 (vim-plug)
" ============================================
call plug#begin('~/.vim/plugged')

" 代码补全
Plug 'neoclide/coc.nvim', {'branch': 'release'}
Plug 'honza/vim-snippets'

" 文件浏览
Plug 'preservim/nerdtree'
Plug 'ryanoasis/vim-devicons'

" 代码结构
Plug 'preservim/tagbar'

" Git 集成
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'

" 代码格式化
Plug 'rhysd/vim-clang-format'

" 语法检查
Plug 'dense-analysis/ale'

" 状态栏
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'

" 注释
Plug 'tpope/vim-commentary'

" 括号补全
Plug 'jiangmiao/auto-pairs'

" 快速搜索
Plug 'ctrlpvim/ctrlp.vim'

" C++ 语法增强
Plug 'octol/vim-cpp-enhanced-highlight'
Plug 'sheerun/vim-polyglot'

" 启动画面
Plug 'mhinz/vim-startify'

call plug#end()

" ============================================
" Coc.nvim 配置
" ============================================
inoremap <silent><expr> <TAB>
      \ pumvisible() ? "\<C-n>" :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ coc#refresh()
inoremap <expr><S-TAB> pumvisible() ? "\<C-p>" : "\<C-h>"

function! s:check_back_space() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

inoremap <silent><expr> <CR> pumvisible() ? coc#_select_confirm() : "\<CR>"

nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)
nmap <leader>rn <Plug>(coc-rename)
nmap <leader>f :ClangFormat<CR>
vmap <leader>f :ClangFormat<CR>

" ============================================
" NERDTree 配置
" ============================================
let NERDTreeShowHidden = 1
let NERDTreeIgnore = ['\.git$', '\.cache$', '\.clangd$', 'node_modules']
nmap <leader>n :NERDTreeToggle<CR>

" ============================================
" Tagbar 配置
" ============================================
nmap <leader>t :TagbarToggle<CR>
let g:tagbar_width = 40

" ============================================
" ALE 配置
" ============================================
let g:ale_linters = {'cpp': ['clang', 'clangtidy', 'cppcheck']}
let g:ale_fixers = {'cpp': ['clang-format']}
let g:ale_fix_on_save = 1

" ============================================
" Airline 配置
" ============================================
let g:airline_theme = 'gruvbox'
let g:airline_powerline_fonts = 1
let g:airline#extensions#tabline#enabled = 1

" ============================================
" 快捷键映射
" ============================================
let mapleader = " "
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>h :nohlsearch<CR>

" 窗口切换
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" 编译运行
function! RunWithASan()
    let l:file = expand("%:r")
    execute "!g++ -fsanitize=address -g -O0 % -o " . l:file
    execute "!ASAN_OPTIONS=detect_leaks=1 ./" . l:file
endfunction

function! RunWithoutASan()
    let l:file = expand("%:r")
    execute "!g++ -O2 % -o " . l:file
    execute "!./" . l:file
endfunction

nmap <F5> :call RunWithASan()<CR>
nmap <F6> :call RunWithoutASan()<CR>
VIMEOF

# ============================================================================
# GDB 配置（修复：注释语法用 # 而非 "）
# ============================================================================
RUN cat > /root/.gdbinit << 'GDBEOF'
# ============================================
# GDB 增强配置
# ============================================

# 基础设置
set pagination off
set confirm off
set print pretty on
set print array on
set print array-indexes on
set print elements 200
set print null-stop
set print vtbl on
set print demangle on
set demangle-style gnu-v3

# 历史记录
set history filename ~/.gdb_history
set history save on
set history size 10000
set history remove-duplicates 1

# 汇编风格
set disassembly-flavor intel

# 语言设置
set language c++

# ============================================
# 颜色输出
# ============================================
set style address foreground yellow
set style function foreground green
set style variable foreground cyan
set style filename foreground magenta

# ============================================
# 自定义命令
# ============================================

define thread_bt
    thread apply all bt
end
document thread_bt
    Show backtrace for all threads
end

define pvector
    if $argc == 1
        set $vec = $arg0
        set $size = $vec._M_impl._M_finish - $vec._M_impl._M_start
        set $capacity = $vec._M_impl._M_end_of_storage - $vec._M_impl._M_start
        printf "Vector size = %d, capacity = %d\n", $size, $capacity
        set $i = 0
        while $i < $size
            printf "  [%d]: ", $i
            p $vec._M_impl._M_start[$i]
            set $i++
        end
    else
        printf "Usage: pvector <vector_name>\n"
    end
end

define pstring
    if $argc == 1
        set $s = $arg0
        printf "Content: \""
        set $i = 0
        while $i < $s._M_rep()._M_length
            printf "%c", $s._M_rep()._M_data()[$i]
            set $i++
        end
        printf "\"\n"
    else
        printf "Usage: pstring <string_name>\n"
    end
end

define cond_break
    break $arg0 if $arg1
end

define log_start
    set logging file gdb.log
    set logging on
    printf "Logging started\n"
end

define log_stop
    set logging off
    printf "Logging stopped\n"
end

# 信号处理
handle SIGSEGV stop print
handle SIGABRT stop print
handle SIGFPE stop print

# 自定义提示符
set prompt \001\033[1;32m\002(gdb)\001\033[0m\002

printf "\n========================================\n"
printf "GDB Enhanced Configuration Loaded\n"
printf "========================================\n"
printf "Custom commands: thread_bt, pvector, pstring, cond_break, log_start/stop\n"
printf "========================================\n\n"
GDBEOF

# ============================================================================
# GDB Python 扩展
# ============================================================================
RUN cat > /root/.gdbinit.py << 'PYEOF'
#!/usr/bin/env python3
import gdb

class RunWithASan(gdb.Command):
    """在 ASan 模式下运行程序"""
    def __init__(self):
        super(RunWithASan, self).__init__("run_asan", gdb.COMMAND_RUN)

    def invoke(self, arg, from_tty):
        gdb.execute("set environment ASAN_OPTIONS=detect_leaks=1:halt_on_error=0")
        gdb.execute("run " + arg)

RunWithASan()
print("GDB Python extensions loaded")
PYEOF

# ============================================================================
# Coc.nvim 配置
# ============================================================================
RUN mkdir -p /root/.config/coc \
    && cat > /root/.config/coc/settings.json << 'COCEOF'
{
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=iwyu"
  ]
}
COCEOF

# ============================================================================
# clangd 项目级配置
# ============================================================================
RUN mkdir -p /root/.clangd \
    && cat > /root/.clangd/config.yaml << 'CLANGDEOF'
CompileFlags:
  Add:
    - -std=c++17
    - -Wall
    - -Wextra
    - -I/usr/local/third/include
Index:
  Background: Build
CLANGDEOF

# ============================================================================
# 辅助脚本
# ============================================================================
RUN cat > /usr/local/bin/gdb-asan << 'ASANEOF'
#!/bin/bash
if [ -z "$1" ]; then
    echo "用法: gdb-asan <程序名>"
    exit 1
fi
gdb -ex "set environment ASAN_OPTIONS=detect_leaks=1:halt_on_error=0" -ex "run" "$1"
ASANEOF

RUN cat > /usr/local/bin/gdb-session << 'SESSIONEOF'
#!/bin/bash
if [ -z "$1" ]; then
    echo "用法: gdb-session <程序名>"
    exit 1
fi
SESSION_NAME=$(date +%Y%m%d_%H%M%S)_$1
gdb -ex "set logging file $SESSION_NAME.log" \
    -ex "set logging on" \
    -ex "set pagination off" \
    -ex "run" \
    -ex "thread apply all bt" \
    -ex "quit" "$1"
echo "Session log saved to: $SESSION_NAME.log"
SESSIONEOF

RUN cat > /usr/local/bin/vim-project << 'PROJECTEOF'
#!/bin/bash
if [ -z "$1" ]; then
    echo "用法: vim-project <项目名称>"
    exit 1
fi

mkdir -p "$1"/{src,include,build}
cd "$1"

cat > CMakeLists.txt << 'CMEOF'
cmake_minimum_required(VERSION 3.10)
project(PROJECT_NAME_PLACEHOLDER VERSION 1.0.0)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

option(ENABLE_ASAN "Enable AddressSanitizer" OFF)

find_package(Boost REQUIRED COMPONENTS system filesystem thread)
find_package(Protobuf REQUIRED)
find_package(fmt REQUIRED)
find_package(spdlog REQUIRED)

add_executable(PROJECT_NAME_PLACEHOLDER src/main.cpp)
target_link_libraries(PROJECT_NAME_PLACEHOLDER
    ${Boost_LIBRARIES}
    ${PROTOBUF_LIBRARIES}
    fmt::fmt
    spdlog::spdlog
)

if(ENABLE_ASAN)
    target_compile_options(PROJECT_NAME_PLACEHOLDER PRIVATE -fsanitize=address -g -O0)
    target_link_options(PROJECT_NAME_PLACEHOLDER PRIVATE -fsanitize=address)
endif()
CMEOF

# 替换项目名占位符
sed -i "s/PROJECT_NAME_PLACEHOLDER/$1/g" CMakeLists.txt

cat > src/main.cpp << 'CPPEOF'
#include <iostream>
#include <boost/version.hpp>

int main() {
    std::cout << "Hello, World!" << std::endl;
    std::cout << "Boost version: " << BOOST_LIB_VERSION << std::endl;
    return 0;
}
CPPEOF

echo "项目 $1 创建成功!"
echo "  cd $1"
echo "  mkdir build && cd build"
echo "  cmake .. && make"
PROJECTEOF

RUN chmod +x /usr/local/bin/gdb-asan /usr/local/bin/gdb-session /usr/local/bin/vim-project

# 统一去除 heredoc 生成文件中的 Windows 换行符，避免 CRLF 导致 Vim/GDB 解析失败
RUN sed -i 's/\r$//' \
    /root/.bashrc \
    /root/.vimrc \
    /root/.gdbinit \
    /root/.gdbinit.py \
    /root/.config/coc/settings.json \
    /root/.clangd/config.yaml \
    /usr/local/bin/gdb-asan \
    /usr/local/bin/gdb-session \
    /usr/local/bin/vim-project

# ============================================================================
# Vim 配色 & 插件管理器
# ============================================================================
RUN mkdir -p /root/.vim/colors /root/.vim/autoload /root/.vim/plugged \
    && curl -fLo /root/.vim/colors/gruvbox.vim \
        https://raw.githubusercontent.com/morhetz/gruvbox/master/colors/gruvbox.vim \
    && curl -fLo /root/.vim/autoload/plug.vim \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

# 安装 Vim 插件
RUN vim +'PlugInstall --sync' +qa || true

# 安装 Coc.nvim 语言服务扩展
RUN mkdir -p /root/.config/coc/extensions \
    && cd /root/.config/coc/extensions \
    && npm install --global-style --no-bin-links --no-package-lock --only=prod \
        coc-clangd \
        coc-cmake \
        coc-json \
        coc-snippets \
        coc-git || true

# ============================================================================
# 第三方库编译安装
# ============================================================================

# ---- 1. Boost 1.85.0 ----
RUN wget -O /tmp/boost_${BOOST_VERSION_UNDERSCORE}.tar.bz2 \
        https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_UNDERSCORE}.tar.bz2 \
    && tar --bzip2 -xf /tmp/boost_${BOOST_VERSION_UNDERSCORE}.tar.bz2 -C /tmp \
    && cd /tmp/boost_${BOOST_VERSION_UNDERSCORE} \
    && ./bootstrap.sh --prefix=${THIRD_PARTY_INSTALL_PREFIX} --with-python=/usr/bin/python3 \
    && ./b2 -j$(nproc) --without-python --without-mpi install \
    && rm -rf /tmp/boost_${BOOST_VERSION_UNDERSCORE}* \
    && ldconfig

# ---- 2. Protobuf 3.21.12 ----
RUN wget -O /tmp/protobuf-cpp-${PROTOBUF_FULL_VERSION}.tar.gz \
        https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOBUF_VERSION}/protobuf-cpp-${PROTOBUF_FULL_VERSION}.tar.gz \
    && tar -xzf /tmp/protobuf-cpp-${PROTOBUF_FULL_VERSION}.tar.gz -C /tmp \
    && cd /tmp/protobuf-${PROTOBUF_FULL_VERSION} \
    && ./configure --prefix=${THIRD_PARTY_INSTALL_PREFIX} \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/protobuf-${PROTOBUF_FULL_VERSION}* \
    && ldconfig

# ---- 3. fmt 10.2.1 ----
RUN git clone --branch ${FMT_VERSION} --depth 1 https://github.com/fmtlib/fmt.git /tmp/fmt \
    && mkdir -p /tmp/fmt/build && cd /tmp/fmt/build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX=${THIRD_PARTY_INSTALL_PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DFMT_TEST=OFF \
    && make -j$(nproc) install \
    && rm -rf /tmp/fmt \
    && ldconfig

# ---- 4. spdlog 1.12.0 ----
RUN git clone --branch v${SPDLOG_VERSION} --depth 1 https://github.com/gabime/spdlog.git /tmp/spdlog \
    && mkdir -p /tmp/spdlog/build && cd /tmp/spdlog/build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX=${THIRD_PARTY_INSTALL_PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DSPDLOG_FMT_EXTERNAL=ON \
        -DSPDLOG_BUILD_EXAMPLE=OFF \
        -DSPDLOG_BUILD_TESTS=OFF \
    && make -j$(nproc) install \
    && rm -rf /tmp/spdlog \
    && ldconfig

# ---- 5. hiredis 1.2.0 ----
RUN git clone --branch v${HIREDIS_VERSION} --depth 1 https://github.com/redis/hiredis.git /tmp/hiredis \
    && mkdir -p /tmp/hiredis/build && cd /tmp/hiredis/build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX=${THIRD_PARTY_INSTALL_PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_SSL=OFF \
    && make -j$(nproc) install \
    && rm -rf /tmp/hiredis \
    && ldconfig

# ---- 6. MySQL++ 3.3.0 ----
RUN wget -O /tmp/mysql++-${MYSQLPP_VERSION}.tar.gz \
        https://tangentsoft.com/mysqlpp/releases/mysql++-${MYSQLPP_VERSION}.tar.gz \
    && tar -xzf /tmp/mysql++-${MYSQLPP_VERSION}.tar.gz -C /tmp \
    && cd /tmp/mysql++-${MYSQLPP_VERSION} \
    && ./configure --prefix=${THIRD_PARTY_INSTALL_PREFIX} --with-mysql=/usr \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/mysql++-${MYSQLPP_VERSION}* \
    && ldconfig

# ---- 7. GoogleTest 1.15.2（单元测试框架, 项目的 -DENABLE_TESTS=ON 依赖它） ----
# 用源码编译而不是 apt 的 libgtest-dev: 跟其它依赖一起落在 CMAKE_PREFIX_PATH 下,
# find_package(GTest) 能直接找到; 版本也和其它库一样在 ENV 里统一管理。
# 注意: googletest 1.14 起自身要求 CMake >= 3.13, Ubuntu 22.04 的 cmake 3.22 满足。
# Release 装的静态库配 Debug/TSAN 的测试二进制没问题: TSAN 是通过动态拦截 pthread
# 来建模同步的, 不要求被测库自身也被插桩。
RUN git clone --branch v${GTEST_VERSION} --depth 1 https://github.com/google/googletest.git /tmp/googletest \
    && mkdir -p /tmp/googletest/build && cd /tmp/googletest/build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX=${THIRD_PARTY_INSTALL_PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_GMOCK=ON \
        -DINSTALL_GTEST=ON \
    && make -j$(nproc) install \
    && rm -rf /tmp/googletest \
    && ldconfig

# ============================================================================
# 验证安装
# ============================================================================
RUN echo "===== 第三方库安装验证 =====" \
    && echo "Boost:    $(ls ${THIRD_PARTY_INSTALL_PREFIX}/lib/libboost_* 2>/dev/null | wc -l) 个库文件" \
    && echo "Protobuf: $(protoc --version 2>/dev/null || echo '未找到')" \
    && echo "fmt:      $(find ${THIRD_PARTY_INSTALL_PREFIX}/lib -name '*fmt*' 2>/dev/null | wc -l) 个文件" \
    && echo "spdlog:   $(find ${THIRD_PARTY_INSTALL_PREFIX}/lib -name '*spdlog*' 2>/dev/null | wc -l) 个文件" \
    && echo "hiredis:  $(find ${THIRD_PARTY_INSTALL_PREFIX}/lib -name '*hiredis*' 2>/dev/null | wc -l) 个文件" \
    && echo "MySQL++:  $(find ${THIRD_PARTY_INSTALL_PREFIX}/lib -name '*mysqlpp*' 2>/dev/null | wc -l) 个文件" \
    && echo "GTest:    $(test -f ${THIRD_PARTY_INSTALL_PREFIX}/lib/cmake/GTest/GTestConfig.cmake && echo 'CMake 配置就绪' || echo '未找到')"

# ============================================================================
# 启动脚本 & 收尾
# ============================================================================
RUN cat > /usr/local/bin/start.sh << 'STARTEOF'
#!/bin/bash
echo "=========================================="
echo "  C++ 开发环境已启动"
echo "=========================================="
echo ""
echo "已安装的组件:"
echo "  - Boost 1.85.0 (Release)"
echo "  - Protobuf 3.21.12 (Release)"
echo "  - fmt 10.2.1 (Release)"
echo "  - spdlog 1.12.0 (Release)"
echo "  - hiredis 1.2.0 (Release)"
echo "  - MySQL++ 3.3.0 (Release)"
echo "  - GoogleTest 1.15.2 (Release, 单元测试)"
echo ""
echo "调试工具:"
echo "  - gdb (增强配置)"
echo "  - gdb-asan <程序>    带 ASan 运行 GDB"
echo "  - gdb-session <程序>  录制调试会话"
echo "  - valgrind"
echo ""
echo "Vim 快捷键:"
echo "  <F5>        编译并运行（带 ASan）"
echo "  <F6>        编译并运行（不带 ASan）"
echo "  <F9>        打开 GDB (TUI)"
echo "  <leader>n   打开文件树"
echo "  <leader>t   打开代码结构"
echo ""
echo "快速创建项目: vim-project <项目名>"
echo "=========================================="
echo ""
tail -f /dev/null
STARTEOF

RUN chmod +x /usr/local/bin/start.sh \
    && sed -i 's/\r$//' /usr/local/bin/start.sh

# 恢复交互式前端（容器启动后如需交互式 apt 可手动取消注释）
# ENV DEBIAN_FRONTEND=dialog

WORKDIR /workspace
CMD ["/usr/local/bin/start.sh"]
